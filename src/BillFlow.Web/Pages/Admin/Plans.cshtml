@page
@model BillFlow.Web.Pages.Admin.PlansModel
@{
    ViewData["Title"] = "Admin · Plans";
}

<h1>Manage plans</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<table>
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Price</th>
            <th>Trial days</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var plan in Model.Plans)
        {
            <tr>
                <td>@plan.Code</td>
                <td>@plan.Name</td>
                <td>$@plan.MonthlyPrice.ToString("0.00")</td>
                <td>@plan.TrialDays</td>
                <td>@(plan.IsActive ? "Yes" : "No")</td>
                <td>
                    <form method="post" asp-page-handler="Toggle">
                        <input type="hidden" name="id" value="@plan.Id" />
                        <input type="hidden" name="name" value="@plan.Name" />
                        <input type="hidden" name="monthlyPrice" value="@plan.MonthlyPrice" />
                        <input type="hidden" name="isActive" value="@(!plan.IsActive)" />
                        <button type="submit" class="btn btn-secondary">@(plan.IsActive ? "Deactivate" : "Activate")</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<h2>New plan</h2>
<div class="card" style="max-width: 420px;">
    <form method="post" asp-page-handler="Create">
        <div class="form-group">
            <label asp-for="NewPlan.Code">Code</label>
            <input asp-for="NewPlan.Code" required />
        </div>
        <div class="form-group">
            <label asp-for="NewPlan.Name">Name</label>
            <input asp-for="NewPlan.Name" required />
        </div>
        <div class="form-group">
            <label asp-for="NewPlan.MonthlyPrice">Monthly price</label>
            <input asp-for="NewPlan.MonthlyPrice" type="number" step="0.01" min="0.01" required />
        </div>
        <div class="form-group">
            <label asp-for="NewPlan.TrialDays">Trial days</label>
            <input asp-for="NewPlan.TrialDays" type="number" step="1" min="0" required />
        </div>
        <button type="submit" class="btn">Create plan</button>
    </form>
</div>
